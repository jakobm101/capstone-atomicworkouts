      "seed": 328493078,
      "version": 2090,
      "versionNonce": 1130455050,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1752680104266,
      "link": null,
      "locked": false,
      "text": "Workouts ALL      api/workouts/index.js                    R\n\nExercsises ALL    api/exercises/index.js                   R\n\nWorkout Single    api/workouts/[id].js                     R D\n\nExercise Single   api/exercises/[id].js                    R\n\nWO + EXs          api/workouts/combined/[workoutId].js    CRUD\n\n(WO: workout EX: exercise)",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Workouts ALL      api/workouts/index.js                    R\n\nExercsises ALL    api/exercises/index.js                   R\n\nWorkout Single    api/workouts/[id].js                     R D\n\nExercise Single   api/exercises/[id].js                    R\n\nWO + EXs          api/workouts/combined/[workoutId].js    CRUD\n\n(WO: workout EX: exercise)",
      "autoResize": true,
      "lineHeight": 1.25
    },
