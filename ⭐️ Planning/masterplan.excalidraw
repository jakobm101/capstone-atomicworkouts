    {
      "id": "EqX5gu0cSzdsFamVgcWKe",
      "type": "text",
      "x": 764.6798345065095,
      "y": 8849.730992883451,
      "width": 1227.599853515625,
      "height": 495,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 1,
